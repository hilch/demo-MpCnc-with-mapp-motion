<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<Configuration>
  <Element ID="gAxisQX" Type="axis">
    <Selector ID="BaseType" Value="LinearBounded">
      <Property ID="MeasurementResolution" Value="0.05" />
